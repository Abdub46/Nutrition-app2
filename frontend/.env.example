# If deploying frontend and backend separately (e.g. Vercel + Render),
# set this and update src/services/api.js baseURL accordingly.
VITE_API_URL=http://localhost:5000/api

# Google Sign-In (OAuth 2.0 Client ID from Google Cloud Console -
# must match the backend's GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com